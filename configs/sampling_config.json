{
    "scenario": "latent_long_0.9",
    "pad_id": 5,
    "vocab_size": 6,
    "dir_protein_features": "/path/to/protein_features",
    "file_p": "/path/to/protein_csv",
    "dir_out": "/path/to/generated_result",
    "max_rna_len": 101,
    "num_per_protein": 1024,
    "num_steps": 2000,
    "cfg_w": null,
    "batch_size": 256,
    "fix_beta": false,
    "clamp_step" : -1,
    "clip_denoised" : false,
    "clamp_first" : true,
    "schedule_name": "sqrt",

    "long_token": false,
    "pretrained_tokenizer": "pretrained_models/GenerRNA/tokenizer_rna",

    "dit": {
        "scale": "small_PE_TE",
        "d_input": 1024,
        "d_model": 128,
        "n_layers": 6,
        "n_heads": 8,
        "max_timesteps": 2000,
        "rmask_null": true,
        "ignore_pad_id": true,
        "dit_pth": "/path/to/trained_model.pth",
        "hidden_t_dim" : 128,
        "max_position_emb_len" : 101
    },
        

    "env":{
        "n_gpus": 4,
        "all_gpus": [0,1,2,3],
        "nccl_port": "65000"
    }
}

